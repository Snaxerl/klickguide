{
  "manifest_version": 3,
  "name": "KlickGuide",
  "version": "1.0.3",
  "description": "Arbeitsabläufe aufnehmen, bearbeiten und als klare Schritt-für-Schritt-Anleitungen exportieren.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KlickGuide",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "KlickGuide öffnen"
    },
    "capture-step": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Manuellen Screenshot aufnehmen"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Aufnahme pausieren oder fortsetzen"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
  },
  "incognito": "not_allowed",
  "options_ui": {
    "page": "app.html#settings",
    "open_in_tab": true
  }
}
